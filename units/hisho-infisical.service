[Unit]
Description=Infisical secrets manager (Hisho add-on; Docker compose)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/.local/share/hisho/infisical
# bin/docker.sh: rootless Docker when the account has it, else the system's (also right after first boot)
ExecStart=/bin/bash %h/code/hisho-addons/infisical/bin/docker.sh compose --env-file .env up -d --remove-orphans
ExecStop=/bin/bash %h/code/hisho-addons/infisical/bin/docker.sh compose --env-file .env down
TimeoutStartSec=600

[Install]
WantedBy=default.target
